{
  // Blocs de style de la revue : taper ::: puis le début du nom affiche la liste (le
  // clic droit → « Mise en forme » aussi). Rendus en fenced divs pandoc,
  // ::: {.classe} … :::, et mis en forme par pipeline/styles/print.css.
  // ⚠ À garder aligné avec les classes définies dans print.css.
  "Important (avec titre)": {
    "prefix": [":::important", "important", "wichtig"],
    "body": ["::: {.important data-titre=\"${1:Important}\"}", "$0", ":::", ""],
    "description": "Bloc « important » à titre paramétrable (rendu par la maquette)"
  },
  "Mise en évidence": {
    "prefix": [":::highlight", "highlight", "evidence", "hervorhebung"],
    "body": ["::: {.highlight}", "$0", ":::", ""],
    "description": "Bloc mis en évidence"
  },
  "Question": {
    "prefix": [":::question", "question", "frage"],
    "body": ["::: {.question}", "$0", ":::", ""],
    "description": "Bloc question"
  },
  "Citation": {
    "prefix": [":::citation", "citation", "zitat"],
    "body": ["> ${1:Citation}", ""],
    "description": "Citation (blockquote natif)"
  }
}
