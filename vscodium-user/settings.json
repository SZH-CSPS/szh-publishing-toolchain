{
  // ---- Interface épurée ----
  "workbench.colorTheme": "Default Light+",
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": true,
  "workbench.editor.showTabs": "single",
  "workbench.layoutControl.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "window.commandCenter": false,
  "window.menuBarVisibility": "compact",
  // Pas de barre latérale secondaire (le panneau « Chat », vide) à droite de l'article.
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  // « Pronto » ouvre une fenêtre vide, sur l’Accueil : rien ne se rouvre au démarrage.
  "window.restoreWindows": "none",
  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false,
  "editor.lineNumbers": "off",
  "editor.glyphMargin": false,
  "editor.folding": false,
  "editor.guides.indentation": false,
  "editor.renderWhitespace": "none",
  "editor.overviewRulerBorder": false,
  // Repères de marge : seul accès à « Prendre cette version » / « Garder la mienne » d'une copie en conflit OneDrive.
  "scm.diffDecorations": "gutter",

  // ---- Confort de rédaction ----
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 90,
  "editor.fontSize": 15,
  "editor.lineHeight": 1.7,
  "editor.cursorBlinking": "smooth",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": false,

  // Aucune suggestion, sauf en Markdown où elles servent aux blocs de style :::
  // (snippets/markdown.json).
  "markdown.validate.enabled": false,
  "editor.quickSuggestions": { "other": false, "comments": false, "strings": false },
  "editor.suggestOnTriggerCharacters": false,
  "editor.parameterHints.enabled": false,
  "[markdown]": {
    "editor.quickSuggestions": { "other": true, "comments": false, "strings": false },
    "editor.suggestOnTriggerCharacters": true,
    "editor.wordBasedSuggestions": "off"
  },

  // ---- Build automatique à la sauvegarde ----
  // Régénère out/<article>/ par la tâche « Aperçu / Export PDF » de tasks.json.
  // Pas les chapitres d'un livre : le cockpit ne recompile que le chapitre enregistré.
  "triggerTaskOnSave.tasks": {
    "Aperçu / Export PDF": ["**/articles/**/*.md", "**/liminaires/**/*.md", "**/*.css", "**/ausgabe.yaml", "**/buch.yaml"]
  },
  "triggerTaskOnSave.restart": true,           // sauvegardes rapprochées : on relance
  // Pas de bascule « Trigger Task on Save » dans la barre d'état : un clic y couperait la
  // compilation à l'enregistrement, sans rien dire. Le verrou d'un numéro passe par
  // triggerTaskOnSave.tasks (lib/verrou.js).
  "triggerTaskOnSave.showStatusBarToggle": false,
  "task.allowAutomaticTasks": "on",

  "search.exclude": { "**/out/**": true, "**/media/**": true },
  // ⚠ Ne pas ajouter "**/out/**" à files.watcherExclude : les événements de
  // modification des PDF seraient étouffés et l'aperçu cesserait de se rafraîchir.
  "files.watcherExclude": { "**/media/**": true, "**/*.tmp": true, "**/~$*": true },

  // ---- Masquage de fichiers dans l'explorateur ----
  // Ajouter ici tout résidu technique à cacher au rédacteur ; le fichier reste sur le
  // disque, il est seulement masqué.
  "files.exclude": {
    "**/.DS_Store": true,
    // Posé par le cockpit au verrouillage d'un numéro (files.readonlyInclude dans
    // <revue>/.vscode/settings.json), supprimé au déverrouillage. Seul fichier technique
    // toléré dans un dossier de revue, et donc masqué.
    "**/.vscode": true,
    // Sortie de la dernière compilation et du dernier import, écrites par les tâches et
    // relues par le cockpit (lib/journal.js) : ce que la chaîne a relevé se lit dans
    // « Contrôles de la compilation », pas dans un fichier de log.
    "**/.szh-journal.log": true,
    "**/.import.log": true,
    // Les baux de co-édition posés par le cockpit pendant qu'un formulaire modifie un
    // fichier (lib/coedition.js) : ils s'effacent seuls, personne n'a à les voir.
    "**/.szh-edition": true,
    // Priorité de compilation posée par le cockpit pour le Makefile (lib/apercu.js) :
    // rien à y lire, l'aperçu suffit.
    "**/.szh-apercu": true,
    // Verdicts PDF/UA en cache (lib/pdfua-hote.js), folios du numéro (pipeline/pagination.py)
    // et empreintes d'import d'un article (pipeline/reimporter.py).
    "**/.szh-pdfua.json": true,
    "**/.szh-pagination.json": true,
    "**/.szh-import.empreintes": true,
    "**/Thumbs.db": true,
    "**/~$*": true,
    "**/*.lnk": true,
    "**/*.meta.yaml": true
  },

  // ---- Correction orthographique ----
  // Un mot est accepté s'il est valide dans au moins une des trois langues : moins de
  // faux positifs en contexte bilingue. Bascule par suffixe de fichier.
  "cSpell.language": "fr,de,en",
  "cSpell.enableFiletypes": ["markdown"],
  "cSpell.words": ["CSPS", "SZH", "WeasyPrint", "Pandoc"],
  "cSpell.overrides": [
    { "filename": "**/*.de.md", "language": "de" },
    { "filename": "**/*.fr.md", "language": "fr" },
    { "filename": "**/*.en.md", "language": "en" }
  ],

  // ---- Sécurité et déploiement de la flotte ----
  // Machine dédiée, contenu connu : on évite la demande de confiance, qui bloquerait le
  // build automatique à la sauvegarde.
  "security.workspace.trust.enabled": false,

  // Extensions : aucune mise à jour en direct, les VSIX sont épinglés (voir VSIX.md).
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "extensions.ignoreRecommendations": true,
  "update.mode": "manual",
  "update.showReleaseNotes": false,
  "telemetry.telemetryLevel": "off",

  // ---- Langue de l'interface ----
  // Anglais par défaut, seule option à jour sur VSCodium. Pour le français, figé en 2021 :
  // épingler MS-CEINTL.vscode-language-pack-fr et poser "locale": "fr" dans
  // %APPDATA%\VSCodium\argv.json.

  // ---- Aperçu PDF ----
  // Rechargement assuré par tomoki1207.pdf ; en cas de blocage, Ctrl+Alt+R (keybindings).
  "editor.acceptSuggestionOnEnter": "smart"
}
