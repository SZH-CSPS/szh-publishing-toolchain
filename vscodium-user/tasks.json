{
  // Tâches au niveau utilisateur, déployées dans %APPDATA%\VSCodium\User\ par update.ps1 :
  // un dossier de revue ne contient ainsi aucun fichier technique.
  //
  // Toutes passent par `bash -c` et non par `make` en direct, pour une seule raison : la
  // sortie de la compilation doit atterrir dans un fichier. La chaîne détecte une dizaine
  // de choses — appel de citation sans référence, tableau sans en-tête, titre vide dans la
  // langue de l'article, PDF non conforme, image manquante — et tout cela partait sur la
  // sortie d'erreur d'un terminal que `reveal: silent` n'ouvre jamais. Le cockpit relit
  // .szh-journal.log à la fin de chaque tâche (lib/journal.js) et pose ce qu'il y trouve
  // dans la vue « Contrôles de la compilation ».
  //
  // ⚠ `set -o pipefail` n'est pas décoratif : sans lui, le code de sortie serait celui de
  //   `tee`, donc toujours 0, et une compilation en échec passerait pour réussie.
  // ⚠ Le journal est à la racine du numéro et non sous out/ : `tout-exporter` commence par
  //   supprimer out/, et `tee` continuerait d'écrire dans un fichier déjà effacé.
  // ⚠ `reveal: silent` reste : un terminal brut n'est pas une interface de rédaction. Ce
  //   qu'il faut lire arrive par l'interface, jamais par le terminal.
  "version": "2.0.0",
  "tasks": [
    {
      // Build par défaut (Ctrl+S, Ctrl+Maj+B, Ctrl+E). `make all` importe d'abord les Word
      // déposés puis régénère out/<article>/ : déposer un Word et sauvegarder suffit.
      "label": "Aperçu / Export PDF",
      "type": "process",                 // pas de shell Windows, donc pas de souci de guillemets
      "command": "wsl.exe",
      "args": [
        "-d", "SZH-Publishing", "--cd", "${workspaceFolder}", "--",
        "bash", "-c",
        "set -o pipefail; make -f '/mnt/c/ProgramData/SZH/toolkit/pipeline/Makefile' all 2>&1 | tee .szh-journal.log"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "silent",
        "showReuseMessage": false,
        "clear": true,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      // Reconstruction forcée de tous les articles, derrière le bouton « Tout exporter ».
      "label": "Tout exporter",
      "type": "process",
      "command": "wsl.exe",
      "args": [
        "-d", "SZH-Publishing", "--cd", "${workspaceFolder}", "--",
        "bash", "-c",
        "set -o pipefail; make -f '/mnt/c/ProgramData/SZH/toolkit/pipeline/Makefile' tout-exporter 2>&1 | tee .szh-journal.log"
      ],
      "presentation": {
        "reveal": "silent",
        "showReuseMessage": false,
        "clear": true,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      // Galleys DOCX de l'export OJS, depuis le HTML autonome : cible `docx`, hors `all`,
      // lancée après « Tout exporter ».
      "label": "Galleys DOCX (OJS)",
      "type": "process",
      "command": "wsl.exe",
      "args": [
        "-d", "SZH-Publishing", "--cd", "${workspaceFolder}", "--",
        "bash", "-c",
        "set -o pipefail; make -f '/mnt/c/ProgramData/SZH/toolkit/pipeline/Makefile' docx 2>&1 | tee .szh-journal.log"
      ],
      "presentation": {
        "reveal": "silent",
        "showReuseMessage": false,
        "clear": true,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      // Import à la demande (Ctrl+Alt+I) ; le build ci-dessus le fait aussi, c'est un
      // secours explicite. runOn:folderOpen ne se déclenche pas toujours pour une tâche
      // utilisateur, la première sauvegarde prend alors le relais.
      "label": "Importer les articles Word",
      "type": "process",
      "command": "wsl.exe",
      "args": [
        "-d", "SZH-Publishing", "--cd", "${workspaceFolder}", "--",
        "bash", "-c",
        "set -o pipefail; make -f '/mnt/c/ProgramData/SZH/toolkit/pipeline/Makefile' import 2>&1 | tee .szh-journal.log"
      ],
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "silent",
        "showReuseMessage": false,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
