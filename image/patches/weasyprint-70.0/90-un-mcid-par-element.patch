+    _follows, _last_mark, _last_shown = {}, None, None
+
+    @contextmanager
+    def text_block(self, follows):
+        """SZH : dessin de lignes dont le texte peut continuer un contenu marqué.
+
+        follows : boîte de texte → (boîte qu'elle continue, vrai si celle-ci est sur la
+        ligne d'avant), voir draw/__init__.py.
+
+        """
+        previous, self._follows = self._follows, follows
+        try:
+            yield
+        finally:
+            self._follows = previous
+
+    def show_text(self, text):
+        super().show_text(text)
+        self._last_shown = (self._current_font, text)
+
+    def _shown_separator(self):
+        """SZH : le dernier glyphe dessiné est-il une espace ou un trait ?
+
+        Lu dans le texte réellement dessiné, et non dans la boîte : l'espace de fin de
+        ligne n'est pas toujours dessinée (droite à gauche, ligne tronquée, police
+        bitmap ou en couleur).
+
+        """
+        if self._last_shown is None or self._last_shown[0] is None:
+            return False
+        (key, _), text = self._last_shown
+        text = str(text)
+        start, end = text.rfind('<'), text.rfind('>')
+        if start < 0 or end < start:
+            return False
+        for font in self._fonts.values():
+            if font.hash == key:
+                size = 2 if font.bitmap else 4
+                glyph = text[start + 1:end][-size:]
+                last = font.to_unicode.get(int(glyph, 16), '')[-1:] if glyph else ''
+                return bool(last) and (last.isspace() or last in '-‐‑–—\xad')
+        return False
 
