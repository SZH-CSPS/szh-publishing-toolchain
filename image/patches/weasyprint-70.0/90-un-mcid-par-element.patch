         draw_block_level(page, stream, blocks_and_cells)
+
+
+def _text_follows(page):
+    """SZH : boîtes de texte de la page qui continuent la boîte de texte précédente.
+
+    L'ordre est celui des boîtes, à plat comme dans _build_box_tree (pdf/tags.py), et
+    non celui du dessin, qui met à part images, flottants et éléments positionnés : une
+    boîte de texte continue la précédente si c'est sa voisine immédiate et qu'elles ont
+    le même élément. Valeur : (boîte précédente, vrai si elle est sur la ligne
+    d'avant). Calculé une fois par page, sur l'arbre d'origine, dont les boîtes de
+    texte sont celles qu'on dessine.
+
+    """
+    follows = getattr(page, 'text_follows', None)
+    if follows is not None:
+        return follows
+    follows = page.text_follows = {}
+    parents = [page]
+    while parents:
+        before = None
+        for child in getattr(parents.pop(), 'children', ()):
+            line = isinstance(child, boxes.LineBox)
+            for index, kid in enumerate(child.children if line else [child]):
+                if not isinstance(kid, boxes.TextBox):
+                    parents.append(kid)
+                elif (isinstance(before, boxes.TextBox) and
+                        kid.element is before.element and
+                        kid.element_tag == before.element_tag):
+                    follows[kid] = (before, index == 0)
+                before = kid
+    return follows
