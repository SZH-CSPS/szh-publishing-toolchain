+    @contextmanager
+    def pagination_artifact(self, box, page=None):
+        """SZH : boîte de marge (en-tête, pied, folio) peinte en artefact de pagination.
+
+        PDF/UA-1 veut la pagination en contenu marqué /Artifact, hors de l'arbre de
+        structure. Sans lien ni champ de formulaire seulement : une annotation doit être
+        balisée (7.18), elle reste donc du contenu, rattaché à l'arbre par tags.py.
+        Le balisage est coupé pendant le dessin (_tags à None, hérité par les groupes).
+
+        """
+        at_keyword = getattr(box, 'at_keyword', None)
+        if self._tags is None or at_keyword is None:
+            yield
+            return
+        # La boîte du contexte d'empilement est une copie sans enfants (stacking.py) :
+        # les liens se cherchent dans la boîte de marge d'origine, enfant de la page.
+        original = next((
+            child for child in getattr(page, 'children', ())
+            if getattr(child, 'at_keyword', None) == at_keyword), box)
+        if _has_annotation(original):
+            yield
+            return
+        side = at_keyword[1:].split('-')[0]  # top, bottom, left, right
+        properties = pydyf.Dictionary({
+            'Type': '/Pagination',
+            'Attached': pydyf.Array([f'/{side.capitalize()}']),
+        })
+        if side in ('top', 'bottom'):
+            properties['Subtype'] = '/Header' if side == 'top' else '/Footer'
+        tags, self._tags = self._tags, None
+        super().begin_marked_content('Artifact', properties)
+        try:
+            yield
+        finally:
+            super().end_marked_content()
+            self._tags = tags
+
