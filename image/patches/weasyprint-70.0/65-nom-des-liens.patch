             anchor_name, pydyf.Array([page.reference, '/XYZ', x, y, 0])])
 
 
+def _get_link_name(element):
+    """Return the accessible name of a link, or an empty string.
+
+    SZH : le nom du lien en /Contents (PDF/UA-1 7.18.5), le premier non vide entre :
+    aria-label, le texte du lien (alt de ses images à défaut), title. Espaces normalisés.
+    Vide, l'appelant écrit la cible.
+
+    """
+    if element is None:
+        return ''
+    text = ''.join(element.itertext())
+    if not text.strip():
+        text = ' '.join(image.get('alt') or '' for image in element.iter('img'))
+    for name in (element.get('aria-label'), text, element.get('title')):
+        if name := ' '.join((name or '').split()):
+            return name
+    return ''
+
