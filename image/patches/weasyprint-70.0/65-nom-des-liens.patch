@@ -246,6 +246,14 @@
         pdf.add_object(object_reference)
         annotations.append((element.reference, annotation))
         element['K'].append(object_reference.reference)
+        # SZH : un lien nommé par aria-label, ou sans texte, porte aussi son nom (le
+        # /Contents posé par pdf/anchors.py) en /Alt de l'élément /Link : c'est ce que lit
+        # un lecteur d'écran à la place du contenu.
+        link = box.element
+        if link is not None and 'Contents' in annotation and (
+                (link.get('aria-label') or '').strip() or
+                not ''.join(link.itertext()).strip()):
+            element['Alt'] = annotation['Contents']
 
     # Include widget annotations.
     if box.widget_annotation:
