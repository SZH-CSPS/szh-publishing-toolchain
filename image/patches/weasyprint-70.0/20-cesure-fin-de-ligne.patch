+def _edge_character(box, last):
+    """Dernier (ou premier) caractère d'une boîte en ligne.
+
+    '' si la boîte est vide ou hors flux, None si elle n'est pas du texte.
+
+    """
+    if isinstance(box, boxes.TextBox):
+        return box.text[-1:] if last else box.text[:1]
+    if isinstance(box, (boxes.LineBox, boxes.InlineBox)):
+        for child in (reversed(box.children) if last else box.children):
+            if (character := _edge_character(child, last)) != '':
+                return character
+        return ''
+    if not box.is_in_normal_flow():
+        return ''
+    return None
+
+
+def _break_at_space(box, skip_stack):
+    """La coupure ``skip_stack`` de ``box`` tombe-t-elle sur une espace ?"""
+    before = after = ''
+    befores, afters = [], []
+    while skip_stack and isinstance(box, (boxes.LineBox, boxes.InlineBox)):
+        (index, skip_stack), = skip_stack.items()
+        if index >= len(box.children):
+            return False
+        befores.append(box.children[:index])
+        afters.append(box.children[index + 1:])
+        box = box.children[index]
+    if isinstance(box, boxes.TextBox):
+        position = next(iter(skip_stack)) if skip_stack else 0
+        text = box.text.encode()
+        before = text[:position].decode()[-1:]
+        after = text[position:].decode()[:1]
+    else:
+        after = _edge_character(box, last=False)
+    for siblings in reversed(befores):
+        for child in reversed(siblings):
+            if before != '':
+                break
+            before = _edge_character(child, last=True)
+    for siblings in reversed(afters):
+        for child in siblings:
+            if after != '':
+                break
+            after = _edge_character(child, last=False)
+    return ' ' in (before, after)
+
+
+def _last_text_box(box):
+    """Dernière boîte de texte non vide d'une ligne, None si la ligne finit autrement."""
+    for child in reversed(box.children):
+        if isinstance(child, boxes.TextBox):
+            if child.text.strip():
+                return child
+        elif isinstance(child, (boxes.LineBox, boxes.InlineBox)):
+            if (textbox := _last_text_box(child)) is not False:
+                return textbox
+        elif child.is_in_normal_flow():
+            return None
+    return False
+
