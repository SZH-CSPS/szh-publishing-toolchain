# Toolchain SZH/CSPS pour la chaîne .md -> Pandoc -> WeasyPrint -> PDF.
# Construit un rootfs Debian reproductible, exporté en .tar.gz puis importé via `wsl --import`.
# Le MÊME Containerfile servira de base bootc à la future migration Silverblue,
# et l'image est aussi poussée sur GHCR (portabilité macOS, PLANIFICATION.md §6).
#
# Toolchain PURE (D2) : le pipeline (Makefile, styles) vit dans le toolkit côté
# Windows — ce rootfs ne change que pour un bump Debian/Pandoc/WeasyPrint (rare).
#
# Build : voir build-rootfs.sh (passe les --build-arg).

ARG DEBIAN_TAG=13-slim
FROM debian:${DEBIAN_TAG}

# --- Paramètres (surchargeables au build) ---
ARG PANDOC_VERSION=3.5
ARG FONTS="fonts-noto fonts-dejavu"
ARG DISTRO_VERSION=0.0.0-dev
ARG WSL_USER=redac

ENV DEBIAN_FRONTEND=noninteractive

# --- Dépendances système : Pango + fontconfig (WeasyPrint), make, python, curl ---
# TODO polices (D7, PLANIFICATION.md §6) : fonts-noto est un métapaquet de plusieurs
# centaines de Mo — le plus gros poste du rootfs après Pandoc. Cible : embarquer les
# polices réelles de la maquette (Open Sans, licence OFL) via le COPY fonts/ ci-dessous,
# puis retirer fonts-noto de ARG FONTS (garder fonts-dejavu en filet de sécurité).
RUN apt-get update && apt-get install -y --no-install-recommends \
        make curl ca-certificates \
        python3 python3-venv \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libffi8 fontconfig \
        ${FONTS} \
    && rm -rf /var/lib/apt/lists/*

# --- WeasyPrint : venv isolé, épinglage COMPLET (transitif) via requirements.txt ---
# (la version de WeasyPrint est DANS requirements.txt — régénération : voir son en-tête)
COPY requirements.txt /tmp/requirements.txt
RUN python3 -m venv /opt/weasyprint \
    && /opt/weasyprint/bin/pip install --no-cache-dir -r /tmp/requirements.txt \
    && ln -s /opt/weasyprint/bin/weasyprint /usr/local/bin/weasyprint \
    && rm /tmp/requirements.txt

# --- AnyStyle (D28) : structuration des listes de références en BibTeX ---
# ruby-dev + build-essential ne servent qu'à compiler l'extension native (wapiti),
# puis sont purgés ; seul le runtime ruby reste.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ruby ruby-dev build-essential \
    && gem install anystyle-cli --no-document \
    && apt-get purge -y ruby-dev build-essential \
    && apt-get autoremove -y --purge \
    && rm -rf /var/lib/apt/lists/* \
    && anystyle --version

# --- Pandoc : binaire statique, version épinglée ---
RUN curl -fsSL "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-1-amd64.deb" \
        -o /tmp/pandoc.deb \
    && dpkg -i /tmp/pandoc.deb \
    && rm /tmp/pandoc.deb

# --- Portraits (F4) : venv isolé /opt/portraits — rembg (détourage) + OpenCV
# YuNet (détection de visage) pour pipeline/portraits.py. Le pipeline ne passe
# PAS par le Makefile : le cockpit appelle directement
#   /opt/portraits/bin/python .../pipeline/portraits.py
# Épinglage COMPLET (transitif) via requirements-portraits.txt (même principe
# que le venv WeasyPrint ci-dessus ; régénération : voir son en-tête). Le test
# de fumée échoue au build si une bibliothèque système manque aux roues pip.
COPY requirements-portraits.txt /tmp/requirements-portraits.txt
RUN python3 -m venv /opt/portraits \
    && /opt/portraits/bin/pip install --no-cache-dir -r /tmp/requirements-portraits.txt \
    && rm /tmp/requirements-portraits.txt \
    && /opt/portraits/bin/python -c "import cv2, rembg, PIL"

# Modèles ONNX téléchargés AU BUILD et vérifiés par sha256 : AUCUN téléchargement
# au runtime (portraits.py pose U2NET_HOME=/opt/portraits/models, où rembg
# retrouve u2net_human_seg.onnx « à plat » sans re-télécharger).
# YuNet : opencv_zoo stocke ses modèles en git-lfs — l'URL raw ne livre qu'un
# pointeur ; on passe par media.githubusercontent.com, épinglé sur un COMMIT
# (contenu immuable). Le sha256 attendu est aussi l'oid du pointeur LFS.
ARG U2NET_URL=https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net_human_seg.onnx
ARG U2NET_SHA256=01eb6a29a5c4d8edb30b56adad9bb3a2a0535338e480724a213e0acfd2d1c73c
ARG YUNET_URL=https://media.githubusercontent.com/media/opencv/opencv_zoo/f12e12798e8314f7c074a6656816c048dcc95b7a/models/face_detection_yunet/face_detection_yunet_2023mar.onnx
ARG YUNET_SHA256=8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4
RUN mkdir -p /opt/portraits/models \
    && curl -fsSL "${U2NET_URL}" -o /opt/portraits/models/u2net_human_seg.onnx \
    && curl -fsSL "${YUNET_URL}" -o /opt/portraits/models/face_detection_yunet_2023mar.onnx \
    && printf '%s  %s\n' \
        "${U2NET_SHA256}" /opt/portraits/models/u2net_human_seg.onnx \
        "${YUNET_SHA256}" /opt/portraits/models/face_detection_yunet_2023mar.onnx \
       | sha256sum -c -

# --- Utilisateur par défaut (imported distro lit /etc/wsl.conf [user] default) ---
RUN useradd -m -s /bin/bash "${WSL_USER}"

# --- Config WSL + marqueur de version (idempotence du déploiement) ---
COPY wsl.conf /etc/wsl.conf
RUN echo "${DISTRO_VERSION}" > /etc/szh-publishing-version

# --- Polices de la maquette : déposer image/fonts/ puis décommenter (voir TODO D7) ---
# COPY fonts/ /usr/local/share/fonts/szh/
RUN fc-cache -f

# Vérification au build (échoue si la toolchain est cassée)
RUN pandoc --version | head -n1 && weasyprint --info | head -n1
