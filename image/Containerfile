# Rootfs Debian de la chaîne .md -> pandoc -> WeasyPrint -> PDF, exporté en .tar.gz pour
# `wsl --import` et publié sur GHCR. Il porte les outils ; le pipeline (Makefile, styles)
# est dans le toolkit côté Windows. Se construit par build-rootfs.sh.
#
# Deux étapes : la première prépare veraPDF et un runtime Java réduit, la seconde (le
# rootfs) ne reçoit que ces deux dossiers, sans le JDK ni binutils qui les fabriquent.

ARG DEBIAN_TAG=13-slim

# ===========================================================================
# Étape intermédiaire : veraPDF, le validateur PDF/UA (cible verifier-ua du Makefile),
# et son runtime Java.
# ===========================================================================
FROM debian:${DEBIAN_TAG} AS verapdf

ARG VERAPDF_VERSION=1.30.2
# URL versionnée : l'alias releases/verapdf-installer.zip suivra la prochaine version et
# ne correspondrait plus au sha256.
ARG VERAPDF_URL=https://software.verapdf.org/releases/1.30/verapdf-greenfield-1.30.2-installer.zip
ARG VERAPDF_SHA256=6cc6341cb1af644044054b81f00a6590a7918abb18f762243de115258bcad838

ENV DEBIAN_FRONTEND=noninteractive

# binutils fournit l'objcopy dont `jlink --strip-debug` a besoin. python3 sert à dézipper.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        curl ca-certificates python3 \
        openjdk-21-jdk-headless binutils \
    && rm -rf /var/lib/apt/lists/*

# Runtime réduit : 56 Mio, contre ~200 pour openjdk-21-jre-headless. Ces sept modules sont
# le minimum : sans java.desktop ni java.management, veraPDF échoue à l'exécution.
RUN jlink --add-modules java.base,java.logging,java.xml,java.desktop,java.naming,java.management,jdk.crypto.ec \
        --strip-debug --no-header-files --no-man-pages --compress=zip-9 --output /jre-min

# L'installeur IzPack attend un écran, sauf avec ce XML d'installation automatique. Sans le
# pack GUI, l'installation passe de ~48 à 16 Mio. La documentation s'installe quand même :
# on la retire avec l'Uninstaller.
RUN curl -fsSL "${VERAPDF_URL}" -o /tmp/vp.zip \
    && printf '%s  %s\n' "${VERAPDF_SHA256}" /tmp/vp.zip | sha256sum -c - \
    && python3 -c "import zipfile; zipfile.ZipFile('/tmp/vp.zip').extractall('/tmp')" \
    && printf '%s\n' \
        '<?xml version="1.0" encoding="UTF-8" standalone="no"?>' \
        '<AutomatedInstallation langpack="eng">' \
        '  <com.izforge.izpack.panels.htmlhello.HTMLHelloPanel id="welcome"/>' \
        '  <com.izforge.izpack.panels.target.TargetPanel id="install_dir">' \
        '    <installpath>/opt/verapdf-cli</installpath>' \
        '  </com.izforge.izpack.panels.target.TargetPanel>' \
        '  <com.izforge.izpack.panels.packs.PacksPanel id="sdk_pack_select">' \
        '    <pack index="0" name="veraPDF GUI" selected="false"/>' \
        '    <pack index="1" name="veraPDF CLI" selected="true"/>' \
        '  </com.izforge.izpack.panels.packs.PacksPanel>' \
        '  <com.izforge.izpack.panels.install.InstallPanel id="install"/>' \
        '  <com.izforge.izpack.panels.finish.SimpleFinishPanel id="finish"/>' \
        '</AutomatedInstallation>' \
       > /tmp/auto.xml \
    && java -jar "/tmp/verapdf-greenfield-${VERAPDF_VERSION}/verapdf-izpack-installer-${VERAPDF_VERSION}.jar" /tmp/auto.xml \
    && rm -rf /opt/verapdf-cli/Uninstaller /opt/verapdf-cli/documents \
        /tmp/vp.zip "/tmp/verapdf-greenfield-${VERAPDF_VERSION}" /tmp/auto.xml

# ===========================================================================
# Le rootfs
# ===========================================================================
FROM debian:${DEBIAN_TAG}

# ---- Paramètres, surchargeables au build ----
ARG PANDOC_VERSION=3.7.0.2
ARG FONTS="fonts-noto fonts-dejavu"
ARG DISTRO_VERSION=0.0.0-dev
ARG WSL_USER=redac

ENV DEBIAN_FRONTEND=noninteractive

# ---- Dépendances système : Pango et fontconfig pour WeasyPrint, make, python, curl ----
# fonts-noto ne sert qu'aux caractères rares : les polices de la maquette sont embarquées
# en base64 par print.css.
# `apt-get upgrade` : l'image de base n'est republiée qu'à intervalles ; sans lui, libc ou
# openssl ne seraient pas mis à jour.
# libharfbuzz-subset0 : WeasyPrint 70 l'utilise pour découper les polices ; sans lui, il
# se rabat sur fontTools avec un avertissement par police et par PDF.
# libreoffice-writer-nogui (~311 Mio) : conversion .odt <-> .docx à l'import
# (pipeline/conversion_odt.py), le reste de l'import ne lisant que le .docx.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        make curl ca-certificates patch \
        python3 python3-venv \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libharfbuzz-subset0 libffi8 fontconfig \
        ghostscript \
        libreoffice-writer-nogui \
        ${FONTS} \
    && rm -rf /var/lib/apt/lists/*

# ghostscript fait la seconde passe du PDF imprimeur d'un livre. WeasyPrint n'écrit qu'en
# DeviceRGB : pipeline/cmjn.py remplace d'abord les couleurs chiffrées par le graphiste,
# puis ghostscript convertit le reste (images, teintes dérivées) par le profil de sortie.

# ---- Profil de sortie CMJN : PSO Uncoated v3 (FOGRA52) ----
# Profil du papier non couché (ISO 12647-2:2013, encrage max 300 %). C'est le papier, pas
# le procédé, qui décide du profil. Le choix se confirme avec l'imprimerie : pour un autre
# profil, seules les lignes ARG ICC_* changent.
#
# Licence : l'ECI permet d'utiliser et d'incorporer ce profil, pas de le distribuer. Il ne
# va donc pas dans le dépôt, qui est public : on le télécharge à la construction.
#
# Épinglé par sha256 : un profil changé en amont changerait la couleur de tous les livres.
# Si ICC_SHA256 est vide, l'image se construit sans profil, et pipeline/cmjn.py refuse
# alors de produire un PDF CMJN.
#
# Source : le registre de l'International Color Consortium, qui sert le .icc directement.
# Le site eci.org renvoie la même page HTML pour toute URL et ne sert plus de fichier.
ARG ICC_URL=https://www.color.org/registry/profiles/PSOuncoated_v3_FOGRA52.icc
ARG ICC_SHA256=7c39f74fbede1e8c85f8fbb9df7d359aea638b9b68dd0854fdd3ba386e3a02c0
ARG ICC_NOM=PSOuncoated_v3_FOGRA52.icc
RUN mkdir -p /opt/icc \
    && if [ -n "${ICC_SHA256}" ]; then \
         curl -fsSL "${ICC_URL}" -o "/tmp/${ICC_NOM}" \
         && printf '%s  %s\n' "${ICC_SHA256}" "/tmp/${ICC_NOM}" | sha256sum -c - \
         && python3 -c "import sys; d=open(sys.argv[1],'rb').read(); \
              sys.exit(0) if d[36:40]==b'acsp' and d[16:20]==b'CMYK' else sys.exit('pas un profil ICC CMJN')" \
              "/tmp/${ICC_NOM}" \
         && mv "/tmp/${ICC_NOM}" "/opt/icc/${ICC_NOM}"; \
       else \
         echo "ICC_SHA256 vide : image construite SANS profil CMJN (voir le commentaire)"; \
       fi

# ---- WeasyPrint : venv isolé, versions épinglées dans requirements.txt ----
# Puis les correctifs de la version installée (patches/weasyprint-<version>/, un fichier
# par sujet, décrit dans son en-tête). Un patch renommé en .patch.off est ignoré, et le
# journal le dit. patch-weasyprint.sh fait échouer la construction si le dossier de cette
# version manque ou si un patch ne s'applique plus exactement : une montée de WeasyPrint
# oblige à les revoir.
COPY requirements.txt /tmp/requirements.txt
COPY patch-weasyprint.sh /tmp/patch-weasyprint.sh
COPY patches/ /tmp/patches/
RUN python3 -m venv /opt/weasyprint \
    && /opt/weasyprint/bin/pip install --no-cache-dir -r /tmp/requirements.txt \
    && sh /tmp/patch-weasyprint.sh /opt/weasyprint/bin/python /tmp/patches \
    && ln -s /opt/weasyprint/bin/weasyprint /usr/local/bin/weasyprint \
    && rm -r /tmp/requirements.txt /tmp/patch-weasyprint.sh /tmp/patches

# ---- pandoc : binaire statique, version et empreinte épinglées ----
# 3.7.0.2 est la dernière version qui lit correctement les zones de texte des Word. À
# partir de 3.8, le lecteur docx place leur contenu avant le paragraphe d'ancrage (dont le
# style de titre se perd) et convertit les formes dessinées en images.
# Même empreinte que PANDOC_DEB_SHA256 dans .github/workflows/ci.yml.
ARG PANDOC_SHA256=4db8bad3d9f8451a3d52171664f3c58b08af6450fbd54a28dd05f6b00b0bbb04
RUN curl -fsSL "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-1-amd64.deb" \
        -o /tmp/pandoc.deb \
    && printf '%s  %s\n' "${PANDOC_SHA256}" /tmp/pandoc.deb | sha256sum -c - \
    && dpkg -i /tmp/pandoc.deb \
    && rm /tmp/pandoc.deb

# ---- Vale : binaire statique, version et empreinte épinglées ----
# Vale applique les règles lexicales et éditoriales du nettoyeur de manuscrit, écrites en
# YAML (pipeline/vale/LISEZMOI.md). Il ne sert que dans la WSL.
ARG VALE_VERSION=3.22.0
ARG VALE_SHA256=52f5cd0314a1b7384cac6aa102a68193977312f6ba9c9f3ae001b5deec8e3a10
RUN curl -fsSL "https://github.com/errata-ai/vale/releases/download/v${VALE_VERSION}/vale_${VALE_VERSION}_Linux_64-bit.tar.gz" \
        -o /tmp/vale.tar.gz \
    && printf '%s  %s\n' "${VALE_SHA256}" /tmp/vale.tar.gz | sha256sum -c - \
    && tar -xzf /tmp/vale.tar.gz -C /usr/local/bin vale \
    && chmod +x /usr/local/bin/vale \
    && rm /tmp/vale.tar.gz

# ---- Portraits : venv isolé /opt/portraits ----
# rembg pour le détourage, OpenCV YuNet pour la détection de visage, utilisés par
# pipeline/portraits.py, que le cockpit appelle directement. L'import final fait échouer la
# construction si une bibliothèque système manque.
COPY requirements-portraits.txt /tmp/requirements-portraits.txt
RUN python3 -m venv /opt/portraits \
    && /opt/portraits/bin/pip install --no-cache-dir -r /tmp/requirements-portraits.txt \
    && rm /tmp/requirements-portraits.txt \
    && /opt/portraits/bin/python -c "import cv2, rembg, PIL"

# Modèles ONNX téléchargés à la construction, pour qu'aucun téléchargement n'ait lieu à
# l'exécution : portraits.py pose U2NET_HOME=/opt/portraits/models. opencv_zoo stocke ses
# modèles en git-lfs et l'URL raw ne livre qu'un pointeur : on passe par
# media.githubusercontent.com, épinglé sur un commit ; le sha256 attendu est l'oid LFS.
ARG U2NET_URL=https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net_human_seg.onnx
ARG U2NET_SHA256=01eb6a29a5c4d8edb30b56adad9bb3a2a0535338e480724a213e0acfd2d1c73c
ARG YUNET_URL=https://media.githubusercontent.com/media/opencv/opencv_zoo/f12e12798e8314f7c074a6656816c048dcc95b7a/models/face_detection_yunet/face_detection_yunet_2023mar.onnx
ARG YUNET_SHA256=8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4
RUN mkdir -p /opt/portraits/models \
    && curl -fsSL "${U2NET_URL}" -o /opt/portraits/models/u2net_human_seg.onnx \
    && curl -fsSL "${YUNET_URL}" -o /opt/portraits/models/face_detection_yunet_2023mar.onnx \
    && printf '%s  %s\n' \
        "${U2NET_SHA256}" /opt/portraits/models/u2net_human_seg.onnx \
        "${YUNET_SHA256}" /opt/portraits/models/face_detection_yunet_2023mar.onnx \
       | sha256sum -c -

# ---- Validation PDF/UA : veraPDF et son runtime, copiés depuis l'étape intermédiaire ----
# Ces chemins sont ceux qu'attend pipeline/Makefile (VERAPDF et VERAPDF_JAVA).
# Le script verapdf cherche java dans JAVA_HOME, sinon dans le PATH. Le rootfs n'a pas de
# JRE système : sans JAVA_HOME, un `verapdf` tapé à la main échouerait avec le code 1, celui
# que veraPDF réserve à un PDF non conforme.
# Placé après les venvs : changer de version de veraPDF ne reconstruit pas le venv des
# portraits ni ses modèles.
COPY --from=verapdf /jre-min /opt/jre-min
COPY --from=verapdf /opt/verapdf-cli /opt/verapdf-cli
ENV JAVA_HOME=/opt/jre-min
RUN ln -s /opt/verapdf-cli/verapdf /usr/local/bin/verapdf

# ---- Utilisateur par défaut : une distro importée lit /etc/wsl.conf [user] default ----
RUN useradd -m -s /bin/bash "${WSL_USER}"

# ---- Config WSL et marqueur de version ----
COPY wsl.conf /etc/wsl.conf

# Seules les polices d'apt sont indexées ; celles de la maquette voyagent dans le HTML.
RUN fc-cache -f

# Vérifie les outils à la construction. `grep` plutôt que `head` : seul le code du dernier
# maillon d'un tube compte, et `head` rend 0 même quand la commande en amont manque.
RUN pandoc --version | grep -m1 "^pandoc" \
    && weasyprint --info | grep -m1 -i "weasyprint" \
    && verapdf --version | grep -m1 "^veraPDF" \
    && vale --version | grep -m1 "^vale version" \
    && soffice --version | grep -m1 -i "office"
