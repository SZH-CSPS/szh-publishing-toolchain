# Rootfs Debian de la chaîne .md -> pandoc -> WeasyPrint -> PDF, exporté en .tar.gz puis
# importé par `wsl --import` ; la même image part aussi sur GHCR. Il ne porte que la
# toolchain, le pipeline (Makefile, styles) vivant dans le toolkit côté Windows.
# Construction : build-rootfs.sh, qui passe les --build-arg.
#
# Deux étapes : la première taille veraPDF et son runtime Java, la seconde — le rootfs —
# n'en reçoit que les deux arborescences finies. Ce qui sert à les fabriquer (JDK, binutils)
# pèse quatre fois ce qu'elles pèsent et n'a rien à faire chez le rédacteur.

ARG DEBIAN_TAG=13-slim

# ===========================================================================
# Étape jetable : veraPDF, le validateur de la porte PDF/UA (cible verifier-ua du
# Makefile), et le runtime Java qui le fait tourner.
# ===========================================================================
FROM debian:${DEBIAN_TAG} AS verapdf

ARG VERAPDF_VERSION=1.30.2
# URL versionnée, et non l'alias releases/verapdf-installer.zip : les deux servent
# aujourd'hui le même octet, mais l'alias suivra le prochain amont et ferait mentir le
# sha256 — l'un sans l'autre ne suffit pas à rendre le build reproductible.
ARG VERAPDF_URL=https://software.verapdf.org/releases/1.30/verapdf-greenfield-1.30.2-installer.zip
ARG VERAPDF_SHA256=6cc6341cb1af644044054b81f00a6590a7918abb18f762243de115258bcad838

ENV DEBIAN_FRONTEND=noninteractive

# binutils pour l'objcopy que `jlink --strip-debug` va chercher — sans lui, jlink s'arrête
# net. python3 sert à dézipper, plutôt qu'un unzip installé pour un seul appel.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates python3 \
        openjdk-21-jdk-headless binutils \
    && rm -rf /var/lib/apt/lists/*

# Runtime taillé sur mesure : 56 Mio, là où openjdk-21-jre-headless en coûterait ~200.
# Les sept modules sont un minimum mesuré, pas une liste de confort : sans java.desktop
# ni java.management, veraPDF casse à l'exécution. Ne pas les retirer.
RUN jlink --add-modules java.base,java.logging,java.xml,java.desktop,java.naming,java.management,jdk.crypto.ec \
        --strip-debug --no-header-files --no-man-pages --compress=zip-9 --output /jre-min

# L'installeur est un IzPack : il attend un écran, sauf si on lui passe ce XML
# d'auto-installation. Le pack GUI désélectionné ramène l'install de ~48 à 16 Mio ; celui
# de documentation s'installe malgré tout, d'où son retrait avec l'Uninstaller.
RUN curl -fsSL "${VERAPDF_URL}" -o /tmp/vp.zip \
    && printf '%s  %s\n' "${VERAPDF_SHA256}" /tmp/vp.zip | sha256sum -c - \
    && python3 -c "import zipfile; zipfile.ZipFile('/tmp/vp.zip').extractall('/tmp')" \
    && printf '%s\n' \
        '<?xml version="1.0" encoding="UTF-8" standalone="no"?>' \
        '<AutomatedInstallation langpack="eng">' \
        '  <com.izforge.izpack.panels.htmlhello.HTMLHelloPanel id="welcome"/>' \
        '  <com.izforge.izpack.panels.target.TargetPanel id="install_dir">' \
        '    <installpath>/opt/verapdf-cli</installpath>' \
        '  </com.izforge.izpack.panels.target.TargetPanel>' \
        '  <com.izforge.izpack.panels.packs.PacksPanel id="sdk_pack_select">' \
        '    <pack index="0" name="veraPDF GUI" selected="false"/>' \
        '    <pack index="1" name="veraPDF CLI" selected="true"/>' \
        '  </com.izforge.izpack.panels.packs.PacksPanel>' \
        '  <com.izforge.izpack.panels.install.InstallPanel id="install"/>' \
        '  <com.izforge.izpack.panels.finish.SimpleFinishPanel id="finish"/>' \
        '</AutomatedInstallation>' \
       > /tmp/auto.xml \
    && java -jar "/tmp/verapdf-greenfield-${VERAPDF_VERSION}/verapdf-izpack-installer-${VERAPDF_VERSION}.jar" /tmp/auto.xml \
    && rm -rf /opt/verapdf-cli/Uninstaller /opt/verapdf-cli/documents \
        /tmp/vp.zip "/tmp/verapdf-greenfield-${VERAPDF_VERSION}" /tmp/auto.xml

# ===========================================================================
# Le rootfs
# ===========================================================================
FROM debian:${DEBIAN_TAG}

# ---- Paramètres, surchargeables au build ----
ARG PANDOC_VERSION=3.5
ARG FONTS="fonts-noto fonts-dejavu"
ARG DISTRO_VERSION=0.0.0-dev
ARG WSL_USER=redac

ENV DEBIAN_FRONTEND=noninteractive

# ---- Dépendances système : Pango et fontconfig pour WeasyPrint, make, python, curl ----
# fonts-noto pèse plusieurs centaines de Mo et n'est qu'un filet pour les caractères
# rares : les polices de la maquette sont embarquées en base64 par print.css.
RUN apt-get update && apt-get install -y --no-install-recommends \
        make curl ca-certificates \
        python3 python3-venv \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libffi8 fontconfig \
        ${FONTS} \
    && rm -rf /var/lib/apt/lists/*

# ---- WeasyPrint : venv isolé, versions épinglées dans requirements.txt ----
COPY requirements.txt /tmp/requirements.txt
RUN python3 -m venv /opt/weasyprint \
    && /opt/weasyprint/bin/pip install --no-cache-dir -r /tmp/requirements.txt \
    && ln -s /opt/weasyprint/bin/weasyprint /usr/local/bin/weasyprint \
    && rm /tmp/requirements.txt

# ---- pandoc : binaire statique, version épinglée ----
RUN curl -fsSL "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-1-amd64.deb" \
        -o /tmp/pandoc.deb \
    && dpkg -i /tmp/pandoc.deb \
    && rm /tmp/pandoc.deb

# ---- Portraits : venv isolé /opt/portraits ----
# rembg pour le détourage, OpenCV YuNet pour la détection de visage, au service de
# pipeline/portraits.py, que le cockpit appelle directement sans passer par le Makefile.
# Le test de fumée fait échouer le build si une bibliothèque système manque aux roues pip.
COPY requirements-portraits.txt /tmp/requirements-portraits.txt
RUN python3 -m venv /opt/portraits \
    && /opt/portraits/bin/pip install --no-cache-dir -r /tmp/requirements-portraits.txt \
    && rm /tmp/requirements-portraits.txt \
    && /opt/portraits/bin/python -c "import cv2, rembg, PIL"

# Modèles ONNX téléchargés au build et vérifiés par sha256, pour qu'il n'y en ait aucun à
# l'exécution : portraits.py pose U2NET_HOME=/opt/portraits/models, où rembg les retrouve.
# opencv_zoo stocke les siens en git-lfs et l'URL raw ne livre qu'un pointeur, d'où
# media.githubusercontent.com épinglé sur un commit ; le sha256 attendu est l'oid LFS.
ARG U2NET_URL=https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net_human_seg.onnx
ARG U2NET_SHA256=01eb6a29a5c4d8edb30b56adad9bb3a2a0535338e480724a213e0acfd2d1c73c
ARG YUNET_URL=https://media.githubusercontent.com/media/opencv/opencv_zoo/f12e12798e8314f7c074a6656816c048dcc95b7a/models/face_detection_yunet/face_detection_yunet_2023mar.onnx
ARG YUNET_SHA256=8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4
RUN mkdir -p /opt/portraits/models \
    && curl -fsSL "${U2NET_URL}" -o /opt/portraits/models/u2net_human_seg.onnx \
    && curl -fsSL "${YUNET_URL}" -o /opt/portraits/models/face_detection_yunet_2023mar.onnx \
    && printf '%s  %s\n' \
        "${U2NET_SHA256}" /opt/portraits/models/u2net_human_seg.onnx \
        "${YUNET_SHA256}" /opt/portraits/models/face_detection_yunet_2023mar.onnx \
       | sha256sum -c -

# ---- Porte PDF/UA : veraPDF et son runtime, versés depuis l'étape jetable ----
# Les deux chemins sont ceux que pipeline/Makefile attend (variables VERAPDF et
# VERAPDF_JAVA) ; les changer ici casse la cible verifier-ua.
# Le lanceur est relocalisable : il cherche java dans JAVA_HOME, sinon dans le PATH. Le
# rootfs n'ayant aucun JRE système, sans ce JAVA_HOME un `verapdf` tapé à la main
# échouerait — et, plus traître, en rendant 1, le code que veraPDF réserve au « PDF non
# conforme ». Rien d'autre dans l'image ne lit JAVA_HOME.
# Placé après les venvs, pas avant : un changement de version de veraPDF ne doit pas
# reconstruire le venv des portraits et ses modèles ONNX.
COPY --from=verapdf /jre-min /opt/jre-min
COPY --from=verapdf /opt/verapdf-cli /opt/verapdf-cli
ENV JAVA_HOME=/opt/jre-min
RUN ln -s /opt/verapdf-cli/verapdf /usr/local/bin/verapdf

# ---- Utilisateur par défaut : une distro importée lit /etc/wsl.conf [user] default ----
RUN useradd -m -s /bin/bash "${WSL_USER}"

# ---- Config WSL et marqueur de version ----
COPY wsl.conf /etc/wsl.conf

# Seules les polices d'apt sont indexées ; celles de la maquette voyagent dans le HTML.
RUN fc-cache -f

# Vérification au build : échoue si la toolchain est cassée. `grep` et non `head` : dans un
# tube, seul le code du dernier maillon compte, et `head` rend 0 même quand la commande en
# amont n'existe pas — la vérification donnait donc son quitus à une image cassée.
RUN pandoc --version | grep -m1 "^pandoc" \
    && weasyprint --info | grep -m1 -i "weasyprint" \
    && verapdf --version | grep -m1 "^veraPDF"
