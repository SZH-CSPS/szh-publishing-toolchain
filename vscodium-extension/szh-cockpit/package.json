{
  "name": "szh-cockpit",
  "displayName": "SZH – Revue (cockpit)",
  "description": "Barre latérale « Pronto » : articles, métadonnées du numéro, import des Word, suivi des traductions, aperçu et réglages.",
  "version": "0.80.0",
  "publisher": "szh-csps",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./extension.js",
  "contributes": {
    "walkthroughs": [
      {
        "id": "szhDemarrage",
        "title": "%tuto.titre%",
        "description": "%tuto.intro%",
        "when": "!szh.estLivre",
        "steps": [
          {
            "id": "szh.tuto.ouvrir",
            "title": "%tuto.ouvrir.titre%",
            "description": "%tuto.ouvrir.texte%",
            "media": {
              "svg": "media/tutoriel/01-ouvrir.svg",
              "altText": "%tuto.ouvrir.titre%"
            },
            "completionEvents": [
              "onView:szhCockpitVue"
            ]
          },
          {
            "id": "szh.tuto.word",
            "title": "%tuto.word.titre%",
            "description": "%tuto.word.texte%",
            "media": {
              "svg": "media/tutoriel/02-word.svg",
              "altText": "%tuto.word.titre%"
            },
            "completionEvents": [
              "onCommand:szh.importerWord",
              "onCommand:szh.convertirEnAttente"
            ]
          },
          {
            "id": "szh.tuto.verifier",
            "title": "%tuto.verifier.titre%",
            "description": "%tuto.verifier.texte%",
            "media": {
              "svg": "media/tutoriel/03-verifier.svg",
              "altText": "%tuto.verifier.titre%"
            },
            "completionEvents": [
              "onCommand:szh.apercuMetadonnees"
            ]
          },
          {
            "id": "szh.tuto.numero",
            "title": "%tuto.numero.titre%",
            "description": "%tuto.numero.texte%",
            "media": {
              "svg": "media/tutoriel/04-numero.svg",
              "altText": "%tuto.numero.titre%"
            },
            "completionEvents": [
              "onCommand:szh.metadonnees"
            ]
          },
          {
            "id": "szh.tuto.medias",
            "title": "%tuto.medias.titre%",
            "description": "%tuto.medias.texte%",
            "media": {
              "svg": "media/tutoriel/05-medias.svg",
              "altText": "%tuto.medias.titre%"
            },
            "completionEvents": [
              "onCommand:szh.mediasArticle"
            ]
          },
          {
            "id": "szh.tuto.tableau",
            "title": "%tuto.tableau.titre%",
            "description": "%tuto.tableau.texte%",
            "media": {
              "svg": "media/tutoriel/06-tableau.svg",
              "altText": "%tuto.tableau.titre%"
            },
            "completionEvents": [
              "onCommand:szh.editerTable"
            ]
          },
          {
            "id": "szh.tuto.traduction",
            "title": "%tuto.traduction.titre%",
            "description": "%tuto.traduction.texte%",
            "media": {
              "svg": "media/tutoriel/07-traduction.svg",
              "altText": "%tuto.traduction.titre%"
            },
            "completionEvents": [
              "onCommand:szh.vueTraductions"
            ]
          },
          {
            "id": "szh.tuto.relire",
            "title": "%tuto.relire.titre%",
            "description": "%tuto.relire.texte%",
            "media": {
              "svg": "media/tutoriel/08-relire.svg",
              "altText": "%tuto.relire.titre%"
            },
            "completionEvents": [
              "onCommand:szh.basculerApercu"
            ]
          },
          {
            "id": "szh.tuto.archiver",
            "title": "%tuto.archiver.titre%",
            "description": "%tuto.archiver.texte%",
            "media": {
              "svg": "media/tutoriel/09-archiver.svg",
              "altText": "%tuto.archiver.titre%"
            },
            "completionEvents": [
              "onCommand:szh.exporterXml"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Pronto",
      "properties": {
        "szh.langue": {
          "type": "string",
          "enum": [
            "",
            "fr",
            "de"
          ],
          "default": "",
          "description": "%config.langue%"
        },
        "szh.shlinkUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%config.shlinkUrl%"
        },
        "szh.mistralModele": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%config.mistralModele%"
        },
        "szh.produitParDefaut": {
          "type": "string",
          "enum": [
            "",
            "revue",
            "zeitschrift",
            "livre"
          ],
          "default": "",
          "scope": "application",
          "description": "%config.produitParDefaut%"
        },
        "szh.apercuMode": {
          "type": "string",
          "enum": [
            "html",
            "pdf"
          ],
          "default": "html",
          "description": "%config.apercuMode%"
        },
        "szh.replierAssetsAutres": {
          "type": "boolean",
          "default": true,
          "description": "%config.replierAssetsAutres%"
        },
        "szh.convertirCmyk": {
          "type": "boolean",
          "default": true,
          "description": "%config.convertirCmyk%"
        },
        "szh.reduireWarningsImpression": {
          "type": "boolean",
          "default": false,
          "description": "%config.reduireWarningsImpression%"
        },
        "szh.desactiverLiensReferences": {
          "type": "boolean",
          "default": false,
          "description": "%config.desactiverLiensReferences%"
        },
        "szh.controlePdfUa": {
          "type": "boolean",
          "default": true,
          "description": "%config.controlePdfUa%"
        },
        "szh.nomUtilisateur": {
          "type": "string",
          "default": "",
          "description": "%config.nomUtilisateur%"
        },
        "szh.formatTravail": {
          "type": "string",
          "enum": [
            "docx",
            "odt"
          ],
          "default": "docx",
          "scope": "application",
          "description": "%config.formatTravail%"
        }
      }
    },
    "configurationDefaults": {
      "workbench.colorTheme": "Default Light+",
      "workbench.activityBar.location": "hidden",
      "workbench.statusBar.visible": true,
      "workbench.editor.showTabs": "single",
      "workbench.layoutControl.enabled": false,
      "workbench.startupEditor": "none",
      "workbench.tips.enabled": false,
      "workbench.editor.editorActionsLocation": "hidden",
      "window.commandCenter": false,
      "window.menuBarVisibility": "compact",
      "workbench.secondarySideBar.defaultVisibility": "hidden",
      "window.restoreWindows": "none",
      "editor.minimap.enabled": false,
      "breadcrumbs.enabled": false,
      "editor.lineNumbers": "off",
      "editor.glyphMargin": false,
      "editor.folding": false,
      "editor.guides.indentation": false,
      "editor.renderWhitespace": "none",
      "editor.overviewRulerBorder": false,
      "scm.diffDecorations": "gutter",
      "editor.wordWrap": "on",
      "editor.wordWrapColumn": 90,
      "editor.fontSize": 15,
      "editor.lineHeight": 1.7,
      "editor.cursorBlinking": "smooth",
      "files.autoSave": "afterDelay",
      "files.autoSaveDelay": 1000,
      "files.trimTrailingWhitespace": false,
      "markdown.validate.enabled": false,
      "editor.quickSuggestions": {
        "other": false,
        "comments": false,
        "strings": false
      },
      "editor.suggestOnTriggerCharacters": false,
      "editor.parameterHints.enabled": false,
      "[markdown]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.wordBasedSuggestions": "off"
      },
      "triggerTaskOnSave.tasks": {
        "Aperçu / Export PDF": [
          "**/articles/**/*.md",
          "**/liminaires/**/*.md",
          "**/*.css",
          "**/ausgabe.yaml",
          "**/buch.yaml"
        ]
      },
      "triggerTaskOnSave.restart": true,
      "triggerTaskOnSave.showStatusBarToggle": false,
      "task.allowAutomaticTasks": "on",
      "search.exclude": {
        "**/out/**": true,
        "**/media/**": true
      },
      "files.watcherExclude": {
        "**/media/**": true,
        "**/*.tmp": true,
        "**/~$*": true
      },
      "files.exclude": {
        "**/.DS_Store": true,
        "**/.vscode": true,
        "**/.szh-journal.log": true,
        "**/.import.log": true,
        "**/.szh-edition": true,
        "**/.szh-apercu": true,
        "**/.szh-pdfua.json": true,
        "**/.szh-pagination.json": true,
        "**/.szh-import.empreintes": true,
        "**/Thumbs.db": true,
        "**/~$*": true,
        "**/*.lnk": true,
        "**/*.meta.yaml": true
      },
      "cSpell.language": "fr,de,en",
      "cSpell.enableFiletypes": [
        "markdown"
      ],
      "cSpell.words": [
        "CSPS",
        "SZH",
        "WeasyPrint",
        "Pandoc"
      ],
      "cSpell.overrides": [
        {
          "filename": "**/*.de.md",
          "language": "de"
        },
        {
          "filename": "**/*.fr.md",
          "language": "fr"
        },
        {
          "filename": "**/*.en.md",
          "language": "en"
        }
      ],
      "security.workspace.trust.enabled": false,
      "extensions.autoCheckUpdates": false,
      "extensions.autoUpdate": false,
      "extensions.ignoreRecommendations": true,
      "update.mode": "manual",
      "update.showReleaseNotes": false,
      "telemetry.telemetryLevel": "off",
      "editor.acceptSuggestionOnEnter": "smart"
    },
    "views": {
      "explorer": [
        {
          "id": "szhCockpitVue",
          "name": "Pronto",
          "when": "szh.estRevue || szh.estLivre"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "%vue.accueil%",
        "when": "workbenchState == empty"
      }
    ],
