{
  "name": "szh-cockpit",
  "displayName": "SZH — Revue (cockpit)",
  "description": "Barre latérale « Revue SZH » : articles et Word en attente d'un numéro (lecture seule).",
  "version": "0.1.0",
  "publisher": "szh-csps",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "SZH",
      "properties": {
        "szh.langue": {
          "type": "string",
          "enum": ["", "fr", "de"],
          "default": "",
          "description": "%config.langue%"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "szhCockpitVue",
          "name": "Revue SZH",
          "when": "szh.estRevue"
        }
      ]
    },
    "commands": [
      {
        "command": "szh.importerWord",
        "title": "%cmd.importerWord%",
        "category": "Revue SZH",
        "icon": "$(add)"
      },
      {
        "command": "szh.cockpit.rafraichir",
        "title": "%cmd.rafraichir%",
        "category": "Revue SZH",
        "icon": "$(refresh)"
      },
      {
        "command": "szh.convertirEnAttente",
        "title": "%cmd.convertirEnAttente%",
        "category": "Revue SZH",
        "icon": "$(run-all)"
      },
      {
        "command": "szh.metadonnees",
        "title": "%cmd.metadonnees%",
        "category": "Revue SZH",
        "icon": "$(gear)"
      },
      {
        "command": "szh.supprimerArticle",
        "title": "%cmd.supprimerArticle%",
        "category": "Revue SZH",
        "icon": "$(trash)"
      },
      {
        "command": "szh.remplacerAsset",
        "title": "%cmd.remplacerAsset%",
        "category": "Revue SZH",
        "icon": "$(replace)"
      },
      {
        "command": "szh.toutExporter",
        "title": "%cmd.toutExporter%",
        "category": "Revue SZH",
        "icon": "$(export)"
      },
      {
        "command": "szh.remplacerTable",
        "title": "%cmd.remplacerTable%",
        "category": "Revue SZH",
        "icon": "$(replace)"
      },
      {
        "command": "szh.apercuMetadonnees",
        "title": "%cmd.apercuMetadonnees%",
        "category": "Revue SZH",
        "icon": "$(list-flat)"
      },
      {
        "command": "szh.reglages",
        "title": "%cmd.reglages%",
        "category": "Revue SZH",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "szh.importerWord",
          "when": "view == szhCockpitVue",
          "group": "navigation@1"
        },
        {
          "command": "szh.cockpit.rafraichir",
          "when": "view == szhCockpitVue",
          "group": "navigation@2"
        },
        {
          "command": "szh.metadonnees",
          "when": "view == szhCockpitVue",
          "group": "navigation@3"
        },
        {
          "command": "szh.toutExporter",
          "when": "view == szhCockpitVue",
          "group": "navigation@4"
        },
        {
          "command": "szh.apercuMetadonnees",
          "when": "view == szhCockpitVue",
          "group": "navigation@5"
        },
        {
          "command": "szh.reglages",
          "when": "view == szhCockpitVue",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "szh.supprimerArticle",
          "when": "view == szhCockpitVue && viewItem == article",
          "group": "inline@1"
        },
        {
          "command": "szh.convertirEnAttente",
          "when": "view == szhCockpitVue && viewItem == section-word",
          "group": "inline"
        },
        {
          "command": "szh.remplacerAsset",
          "when": "view == szhCockpitVue && viewItem == asset",
          "group": "inline"
        },
        {
          "command": "szh.remplacerTable",
          "when": "view == szhCockpitVue && viewItem == table",
          "group": "inline"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SZH-CSPS/szh-publishing-toolchain"
  }
}
