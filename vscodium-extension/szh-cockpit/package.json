    "menus": {
      "scm/change/title": [
        {
          "command": "szh.conflit.prendre",
          "when": "originalResourceScheme == szh-conflit",
          "group": "1_modification@1"
        },
        {
          "command": "szh.conflit.garder",
          "when": "originalResourceScheme == szh-conflit",
          "group": "1_modification@2"
        }
      ],
      "commandPalette": [
        {
          "command": "szh.conflit.prendre",
          "when": "false"
        },
        {
          "command": "szh.conflit.garder",
          "when": "false"
        },
        {
          "command": "szh.importerWord",
          "when": "szh.estRevue || szh.estLivre"
        },
        {
          "command": "szh.cockpit.rafraichir",
          "when": "szh.estRevue || szh.estLivre"
        },
        {
          "command": "szh.convertirEnAttente",
          "when": "szh.estRevue || szh.estLivre"
        },
        {
          "command": "szh.metadonnees",
          "when": "szh.estRevue || szh.estLivre"
        },
        {
          "command": "szh.supprimerArticle",
          "when": "szh.estRevue || szh.estLivre"
        },
        {
          "command": "szh.reimporterArticle",
          "when": "szh.peut.reimport"
        },
        {
          "command": "szh.annulerReimport",
          "when": "szh.peut.reimport"
        },
        {
          "command": "szh.toutExporter",
          "when": "szh.estRevue || szh.estLivre"
        },
        {
          "command": "szh.exporterXml",
          "when": "szh.peut.ojs"
        },
        {
          "command": "szh.rafraichirPagination",
          "when": "szh.peut.pagination"
        },
        {
          "command": "szh.exporterArticle",
          "when": "szh.peut.pdfArticle"
        },
        {
          "command": "szh.livreImprimeur",
          "when": "szh.peut.sortiesLivre"
        },
        {
          "command": "szh.livreCouverture",
          "when": "szh.peut.sortiesLivre"
