{
  "name": "szh-cockpit",
  "displayName": "SZH — Revue (cockpit)",
  "description": "Barre latérale « Revue SZH » : articles, métadonnées du numéro, import des Word, suivi des traductions, aperçu et réglages.",
  "version": "0.19.1",
  "publisher": "szh-csps",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "SZH",
      "properties": {
        "szh.langue": {
          "type": "string",
          "enum": ["", "fr", "de"],
          "default": "",
          "description": "%config.langue%"
        },
        "szh.apercuMode": {
          "type": "string",
          "enum": ["html", "pdf"],
          "default": "html",
          "description": "%config.apercuMode%"
        },
        "szh.replierAssetsAutres": {
          "type": "boolean",
          "default": true,
          "description": "%config.replierAssetsAutres%"
        },
        "szh.convertirCmyk": {
          "type": "boolean",
          "default": true,
          "description": "%config.convertirCmyk%"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "szhCockpitVue",
          "name": "Revue SZH",
          "when": "szh.estRevue"
        }
      ]
    },
    "commands": [
      {
        "command": "szh.importerWord",
        "title": "%cmd.importerWord%",
        "category": "Revue SZH",
        "icon": "$(add)"
      },
      {
        "command": "szh.cockpit.rafraichir",
        "title": "%cmd.rafraichir%",
        "category": "Revue SZH",
        "icon": "$(refresh)"
      },
      {
        "command": "szh.convertirEnAttente",
        "title": "%cmd.convertirEnAttente%",
        "category": "Revue SZH",
        "icon": "$(run-all)"
      },
      {
        "command": "szh.metadonnees",
        "title": "%cmd.metadonnees%",
        "category": "Revue SZH",
        "icon": "$(gear)"
      },
      {
        "command": "szh.supprimerArticle",
        "title": "%cmd.supprimerArticle%",
        "category": "Revue SZH",
        "icon": "$(trash)"
      },
      {
        "command": "szh.toutExporter",
        "title": "%cmd.toutExporter%",
        "category": "Revue SZH",
        "icon": "$(export)"
      },
      {
        "command": "szh.exporterXml",
        "title": "%cmd.exporterXml%",
        "category": "Revue SZH",
        "icon": "$(file-code)"
      },
      {
        "command": "szh.exporterArticle",
        "title": "%cmd.exporterArticle%",
        "category": "Revue SZH",
        "icon": "$(file-pdf)"
      },
      {
        "command": "szh.archiverVerrouiller",
        "title": "%cmd.archiverVerrouiller%",
        "category": "Revue SZH",
        "icon": "$(archive)"
      },
      {
        "command": "szh.deverrouiller",
        "title": "%cmd.deverrouiller%",
        "category": "Revue SZH",
        "icon": "$(unlock)"
      },
      {
        "command": "szh.desarchiver",
        "title": "%cmd.desarchiver%",
        "category": "Revue SZH",
        "icon": "$(folder-opened)"
      },
      {
        "command": "szh.remplacerTable",
        "title": "%cmd.remplacerTable%",
        "category": "Revue SZH",
        "icon": "$(replace)"
      },
      {
        "command": "szh.supprimerTable",
        "title": "%cmd.supprimerTable%",
        "category": "Revue SZH",
        "icon": "$(trash)"
      },
      {
        "command": "szh.editerTable",
        "title": "%cmd.editerTable%",
        "category": "Revue SZH",
        "icon": "$(edit)"
      },
      {
        "command": "szh.apercuMetadonnees",
        "title": "%cmd.apercuMetadonnees%",
        "category": "Revue SZH",
        "icon": "$(list-flat)"
      },
      {
        "command": "szh.metadonneesArticle",
        "title": "%cmd.metadonneesArticle%",
        "category": "Revue SZH",
        "icon": "$(list-flat)"
      },
      {
        "command": "szh.mediasArticle",
        "title": "%cmd.mediasArticle%",
        "category": "Revue SZH",
        "icon": "$(file-media)"
      },
      {
        "command": "szh.traduction",
        "title": "%cmd.traduction%",
        "category": "Revue SZH",
        "icon": "$(globe)"
      },
      {
        "command": "szh.traductionsToutPret",
        "title": "%cmd.traductionsToutPret%",
        "category": "Revue SZH",
        "icon": "$(check-all)"
      },
      {
        "command": "szh.envoyerTraduction",
        "title": "%cmd.envoyerTraduction%",
        "category": "Revue SZH",
        "icon": "$(mail)"
      },
      {
        "command": "szh.reglages",
        "title": "%cmd.reglages%",
        "category": "Revue SZH",
        "icon": "$(settings-gear)"
      },
      {
        "command": "szh.basculerApercu",
        "title": "%cmd.basculerApercu%",
        "category": "Revue SZH",
        "icon": "$(preview)"
      },
      {
        "command": "szh.panneauCommande",
        "title": "%cmd.panneauCommande%",
        "category": "Revue SZH",
        "icon": "$(rocket)"
      },
      {
        "command": "szh.panneauEdition",
        "title": "%cmd.panneauEdition%",
        "category": "Revue SZH",
        "icon": "$(edit)"
      },
      {
        "command": "szh.panneauExport",
        "title": "%cmd.panneauExport%",
        "category": "Revue SZH",
        "icon": "$(export)"
      },
      {
        "command": "szh.miseEnForme",
        "title": "%cmd.miseEnForme%",
        "category": "Revue SZH",
        "icon": "$(list-selection)"
      },
      { "command": "szh.fmt.gras", "title": "%cmd.fmt.gras%", "category": "Revue SZH" },
      { "command": "szh.fmt.italique", "title": "%cmd.fmt.italique%", "category": "Revue SZH" },
      { "command": "szh.fmt.souligne", "title": "%cmd.fmt.souligne%", "category": "Revue SZH" },
      { "command": "szh.fmt.titre1", "title": "%cmd.fmt.titre1%", "category": "Revue SZH" },
      { "command": "szh.fmt.titre2", "title": "%cmd.fmt.titre2%", "category": "Revue SZH" },
      { "command": "szh.fmt.titre3", "title": "%cmd.fmt.titre3%", "category": "Revue SZH" },
      { "command": "szh.fmt.important", "title": "%cmd.fmt.important%", "category": "Revue SZH" },
      { "command": "szh.fmt.highlight", "title": "%cmd.fmt.highlight%", "category": "Revue SZH" },
      { "command": "szh.fmt.question", "title": "%cmd.fmt.question%", "category": "Revue SZH" },
      { "command": "szh.fmt.citation", "title": "%cmd.fmt.citation%", "category": "Revue SZH" },
      { "command": "szh.fmt.figure", "title": "%cmd.fmt.figure%", "category": "Revue SZH" },
      { "command": "szh.fmt.tableau", "title": "%cmd.fmt.tableau%", "category": "Revue SZH" },
      { "command": "szh.fmt.collerTableau", "title": "%cmd.fmt.collerTableau%", "category": "Revue SZH" },
      { "command": "szh.fmt.sautPage", "title": "%cmd.fmt.sautPage%", "category": "Revue SZH" },
      { "command": "szh.lierReference", "title": "%cmd.lierReference%", "category": "Revue SZH", "icon": "$(references)" }
    ],
    "menus": {
      "editor/context": [
        { "command": "szh.miseEnForme", "group": "navigation@1", "when": "editorLangId == markdown && editorTextFocus" }
      ],
      "editor/title": [
        { "command": "szh.basculerApercu", "group": "navigation", "when": "resourceExtname == .pdf && szh.estRevue || activeCustomEditorId == 'pdf.preview' && szh.estRevue" }
      ],
      "view/title": [
        {
          "command": "szh.panneauCommande",
          "when": "view == szhCockpitVue",
          "group": "navigation@1"
        },
        {
          "command": "szh.panneauEdition",
          "when": "view == szhCockpitVue",
          "group": "navigation@2"
        },
        {
          "command": "szh.panneauExport",
          "when": "view == szhCockpitVue",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "szh.exporterArticle",
          "when": "view == szhCockpitVue && viewItem == article && (szh.archivee || szh.verrouillee)",
          "group": "inline@0"
        },
        {
          "command": "szh.metadonneesArticle",
          "when": "view == szhCockpitVue && viewItem == article && !szh.verrouillee",
          "group": "inline@1"
        },
        {
          "command": "szh.mediasArticle",
          "when": "view == szhCockpitVue && viewItem == article && !szh.verrouillee",
          "group": "inline@2"
        },
        {
          "command": "szh.supprimerArticle",
          "when": "view == szhCockpitVue && viewItem == article && !szh.verrouillee",
          "group": "inline@3"
        },
        {
          "command": "szh.convertirEnAttente",
          "when": "view == szhCockpitVue && viewItem == section-word && !szh.verrouillee",
          "group": "inline"
        },
        {
          "command": "szh.traductionsToutPret",
          "when": "view == szhCockpitVue && viewItem == section-traductions && !szh.verrouillee",
          "group": "inline@1"
        },
        {
          "command": "szh.envoyerTraduction",
          "when": "view == szhCockpitVue && viewItem == section-traductions",
          "group": "inline@2"
        },
        {
          "command": "szh.envoyerTraduction",
          "when": "view == szhCockpitVue && viewItem == traduction-article",
          "group": "inline@1"
        },
        {
          "command": "szh.remplacerTable",
          "when": "view == szhCockpitVue && viewItem == table && !szh.verrouillee",
          "group": "inline@1"
        },
        {
          "command": "szh.supprimerTable",
          "when": "view == szhCockpitVue && viewItem == table && !szh.verrouillee",
          "group": "inline@2"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SZH-CSPS/szh-publishing-toolchain"
  }
}
