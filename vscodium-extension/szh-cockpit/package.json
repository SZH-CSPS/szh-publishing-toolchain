{
  "name": "szh-cockpit",
  "displayName": "SZH – Revue (cockpit)",
  "description": "Barre latérale « Revue SZH » : articles, métadonnées du numéro, import des Word, suivi des traductions, aperçu et réglages.",
  "version": "0.27.0",
  "publisher": "szh-csps",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "walkthroughs": [
      {
        "id": "szhDemarrage",
        "title": "%tuto.titre%",
        "description": "%tuto.intro%",
        "steps": [
        {
          "id": "szh.tuto.ouvrir",
          "title": "%tuto.ouvrir.titre%",
          "description": "%tuto.ouvrir.texte%",
          "media": { "svg": "media/tutoriel/01-ouvrir.svg", "altText": "%tuto.ouvrir.titre%" },
          "completionEvents": ["onView:szhCockpitVue"]
        },
        {
          "id": "szh.tuto.word",
          "title": "%tuto.word.titre%",
          "description": "%tuto.word.texte%",
          "media": { "svg": "media/tutoriel/02-word.svg", "altText": "%tuto.word.titre%" },
          "completionEvents": ["onCommand:szh.convertirEnAttente"]
        },
        {
          "id": "szh.tuto.verifier",
          "title": "%tuto.verifier.titre%",
          "description": "%tuto.verifier.texte%",
          "media": { "svg": "media/tutoriel/03-verifier.svg", "altText": "%tuto.verifier.titre%" },
          "completionEvents": ["onCommand:szh.apercuMetadonnees"]
        },
        {
          "id": "szh.tuto.numero",
          "title": "%tuto.numero.titre%",
          "description": "%tuto.numero.texte%",
          "media": { "svg": "media/tutoriel/04-numero.svg", "altText": "%tuto.numero.titre%" },
          "completionEvents": ["onCommand:szh.metadonnees"]
        },
        {
          "id": "szh.tuto.medias",
          "title": "%tuto.medias.titre%",
          "description": "%tuto.medias.texte%",
          "media": { "svg": "media/tutoriel/05-medias.svg", "altText": "%tuto.medias.titre%" },
          "completionEvents": ["onCommand:szh.mediasArticle"]
        },
        {
          "id": "szh.tuto.tableau",
          "title": "%tuto.tableau.titre%",
          "description": "%tuto.tableau.texte%",
          "media": { "svg": "media/tutoriel/06-tableau.svg", "altText": "%tuto.tableau.titre%" },
          "completionEvents": ["onCommand:szh.editerTable"]
        },
        {
          "id": "szh.tuto.traduction",
          "title": "%tuto.traduction.titre%",
          "description": "%tuto.traduction.texte%",
          "media": { "svg": "media/tutoriel/07-traduction.svg", "altText": "%tuto.traduction.titre%" },
          "completionEvents": ["onCommand:szh.vueTraductions"]
        },
        {
          "id": "szh.tuto.relire",
          "title": "%tuto.relire.titre%",
          "description": "%tuto.relire.texte%",
          "media": { "svg": "media/tutoriel/08-relire.svg", "altText": "%tuto.relire.titre%" },
          "completionEvents": ["onCommand:szh.basculerApercu"]
        },
        {
          "id": "szh.tuto.archiver",
          "title": "%tuto.archiver.titre%",
          "description": "%tuto.archiver.texte%",
          "media": { "svg": "media/tutoriel/09-archiver.svg", "altText": "%tuto.archiver.titre%" },
          "completionEvents": ["onCommand:szh.exporterXml"]
        }
        ]
      }
    ],
    "configuration": {
      "title": "SZH",
      "properties": {
        "szh.langue": {
          "type": "string",
          "enum": ["", "fr", "de"],
          "default": "",
          "description": "%config.langue%"
        },
        "szh.apercuMode": {
          "type": "string",
          "enum": ["html", "pdf"],
          "default": "html",
          "description": "%config.apercuMode%"
        },
        "szh.replierAssetsAutres": {
          "type": "boolean",
          "default": true,
          "description": "%config.replierAssetsAutres%"
        },
        "szh.convertirCmyk": {
          "type": "boolean",
          "default": true,
          "description": "%config.convertirCmyk%"
        },
        "szh.reduireWarningsImpression": {
          "type": "boolean",
          "default": false,
          "description": "%config.reduireWarningsImpression%"
        },
        "szh.nomUtilisateur": {
          "type": "string",
          "default": "",
          "description": "%config.nomUtilisateur%"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "szhCockpitVue",
          "name": "SZH/CSPS",
          "when": "szh.estRevue || szh.estLivre"
        }
      ]
    },
    "commands": [
      {
        "command": "szh.importerWord",
        "title": "%cmd.importerWord%",
        "category": "Revue SZH",
        "icon": "$(add)"
      },
      {
        "command": "szh.cockpit.rafraichir",
        "title": "%cmd.rafraichir%",
        "category": "Revue SZH",
        "icon": "$(refresh)"
      },
      {
        "command": "szh.convertirEnAttente",
        "title": "%cmd.convertirEnAttente%",
        "category": "Revue SZH",
        "icon": "$(run-all)"
      },
      {
        "command": "szh.metadonnees",
        "title": "%cmd.metadonnees%",
        "category": "Revue SZH",
        "icon": "$(gear)"
      },
      {
        "command": "szh.supprimerArticle",
        "title": "%cmd.supprimerArticle%",
        "category": "Revue SZH",
        "icon": "$(trash)"
      },
      {
        "command": "szh.reimporterArticle",
        "title": "%cmd.reimporterArticle%",
        "category": "Revue SZH",
        "icon": "$(sync)"
      },
      {
        "command": "szh.annulerReimport",
        "title": "%cmd.annulerReimport%",
        "category": "Revue SZH",
        "icon": "$(discard)"
      },
      {
        "command": "szh.toutExporter",
        "title": "%cmd.toutExporter%",
        "category": "Revue SZH",
        "icon": "$(export)"
      },
      {
        "command": "szh.exporterXml",
        "title": "%cmd.exporterXml%",
        "category": "Revue SZH",
        "icon": "$(file-code)"
      },
      {
        "command": "szh.exporterArticle",
        "title": "%cmd.exporterArticle%",
        "category": "Revue SZH",
        "icon": "$(file-pdf)"
      },
      {
        "command": "szh.archiverVerrouiller",
        "title": "%cmd.archiverVerrouiller%",
        "category": "Revue SZH",
        "icon": "$(archive)"
      },
      {
        "command": "szh.deverrouiller",
        "title": "%cmd.deverrouiller%",
        "category": "Revue SZH",
        "icon": "$(unlock)"
      },
      {
        "command": "szh.desarchiver",
        "title": "%cmd.desarchiver%",
        "category": "Revue SZH",
        "icon": "$(folder-opened)"
      },
      {
        "command": "szh.supprimerTable",
        "title": "%cmd.supprimerTable%",
        "category": "Revue SZH",
        "icon": "$(trash)"
      },
      {
        "command": "szh.editerTable",
        "title": "%cmd.editerTable%",
        "category": "Revue SZH",
        "icon": "$(edit)"
      },
      {
        "command": "szh.apercuMetadonnees",
        "title": "%cmd.apercuMetadonnees%",
        "category": "Revue SZH",
        "icon": "$(list-flat)"
      },
      {
        "command": "szh.metadonneesArticle",
        "title": "%cmd.metadonneesArticle%",
        "category": "Revue SZH",
        "icon": "$(list-flat)"
      },
      {
        "command": "szh.mediasArticle",
        "title": "%cmd.mediasArticle%",
        "category": "Revue SZH",
        "icon": "$(file-media)"
      },
      {
        "command": "szh.traduction",
        "title": "%cmd.traduction%",
        "category": "Revue SZH",
        "icon": "$(globe)"
      },
      {
        "command": "szh.tutoriel",
        "title": "%cmd.tutoriel%",
        "category": "Revue SZH",
        "icon": "$(mortar-board)"
      },
      {
        "command": "szh.vueArticles",
        "title": "%cmd.vueArticles%",
        "category": "Revue SZH",
        "icon": "$(dashboard)"
      },
      {
        "command": "szh.envoyerAuteur",
        "title": "%cmd.envoyerAuteur%",
        "category": "Revue SZH",
        "icon": "$(mail)"
      },
      {
        "command": "szh.vueTraductions",
        "title": "%cmd.vueTraductions%",
        "category": "Revue SZH",
        "icon": "$(dashboard)"
      },
      {
        "command": "szh.vueWord",
        "title": "%cmd.vueWord%",
        "category": "Revue SZH",
        "icon": "$(dashboard)"
      },
      {
        "command": "szh.vueControles",
        "title": "%cmd.vueControles%",
        "category": "Revue SZH"
      },
      {
        "command": "szh.traductionsToutPret",
        "title": "%cmd.traductionsToutPret%",
        "category": "Revue SZH",
        "icon": "$(check-all)"
      },
      {
        "command": "szh.envoyerTraduction",
        "title": "%cmd.envoyerTraduction%",
        "category": "Revue SZH",
        "icon": "$(mail)"
      },
      {
        "command": "szh.reglages",
        "title": "%cmd.reglages%",
        "category": "Revue SZH",
        "icon": "$(settings-gear)"
      },
      {
        "command": "szh.basculerApercu",
        "title": "%cmd.basculerApercu%",
        "category": "Revue SZH",
        "icon": "$(preview)"
      },
      {
        "command": "szh.panneauCommande",
        "title": "%cmd.panneauCommande%",
        "category": "Revue SZH",
        "icon": "$(rocket)"
      },
      {
        "command": "szh.panneauEdition",
        "title": "%cmd.panneauEdition%",
        "category": "Revue SZH",
        "icon": "$(edit)"
      },
      {
        "command": "szh.panneauExport",
        "title": "%cmd.panneauExport%",
        "category": "Revue SZH",
        "icon": "$(export)"
      },
      {
        "command": "szh.miseEnForme",
        "title": "%cmd.miseEnForme%",
        "category": "Revue SZH",
        "icon": "$(list-selection)"
      },
      { "command": "szh.fmt.gras", "title": "%cmd.fmt.gras%", "category": "Revue SZH" },
      { "command": "szh.fmt.italique", "title": "%cmd.fmt.italique%", "category": "Revue SZH" },
      { "command": "szh.fmt.souligne", "title": "%cmd.fmt.souligne%", "category": "Revue SZH" },
      { "command": "szh.fmt.titre1", "title": "%cmd.fmt.titre1%", "category": "Revue SZH" },
      { "command": "szh.fmt.titre2", "title": "%cmd.fmt.titre2%", "category": "Revue SZH" },
      { "command": "szh.fmt.titre3", "title": "%cmd.fmt.titre3%", "category": "Revue SZH" },
      { "command": "szh.fmt.important", "title": "%cmd.fmt.important%", "category": "Revue SZH" },
      { "command": "szh.fmt.highlight", "title": "%cmd.fmt.highlight%", "category": "Revue SZH" },
      { "command": "szh.fmt.question", "title": "%cmd.fmt.question%", "category": "Revue SZH" },
      { "command": "szh.fmt.citation", "title": "%cmd.fmt.citation%", "category": "Revue SZH" },
      { "command": "szh.fmt.figure", "title": "%cmd.fmt.figure%", "category": "Revue SZH" },
      { "command": "szh.fmt.tableau", "title": "%cmd.fmt.tableau%", "category": "Revue SZH" },
      { "command": "szh.fmt.collerTableau", "title": "%cmd.fmt.collerTableau%", "category": "Revue SZH" },
      { "command": "szh.fmt.sautPage", "title": "%cmd.fmt.sautPage%", "category": "Revue SZH" },
      { "command": "szh.lierReference", "title": "%cmd.lierReference%", "category": "Revue SZH", "icon": "$(references)" },
      { "command": "szh.conflit.comparer", "title": "%cmd.conflit.comparer%", "category": "Revue SZH", "icon": "$(diff)" },
      { "command": "szh.conflit.prendre", "title": "%cmd.conflit.prendre%", "category": "Revue SZH" },
      { "command": "szh.conflit.garder", "title": "%cmd.conflit.garder%", "category": "Revue SZH" },
      { "command": "szh.conflit.supprimerCopie", "title": "%cmd.conflit.supprimerCopie%", "category": "Revue SZH", "icon": "$(trash)" }
    ],
    "menus": {
      "scm/change/title": [
        { "command": "szh.conflit.prendre", "when": "originalResourceScheme == szh-conflit", "group": "1_modification@1" },
        { "command": "szh.conflit.garder", "when": "originalResourceScheme == szh-conflit", "group": "1_modification@2" }
      ],
      "commandPalette": [
        { "command": "szh.conflit.prendre", "when": "false" },
        { "command": "szh.conflit.garder", "when": "false" }
      ],
      "scm/resourceState/context": [
        { "command": "szh.conflit.comparer", "when": "scmProvider == szh.conflits", "group": "inline@1" },
        { "command": "szh.conflit.supprimerCopie", "when": "scmProvider == szh.conflits", "group": "inline@2" }
      ],
      "editor/context": [
        { "command": "szh.miseEnForme", "group": "navigation@1", "when": "editorLangId == markdown && editorTextFocus" }
      ],
      "editor/title": [
        { "command": "szh.basculerApercu", "group": "navigation", "when": "resourceExtname == .pdf && szh.estRevue || activeCustomEditorId == 'pdf.preview' && szh.estRevue" }
      ],
      "view/title": [
        {
          "command": "szh.tutoriel",
          "when": "view == szhCockpitVue",
          "group": "navigation@9"
        },
        {
          "command": "szh.panneauCommande",
          "when": "view == szhCockpitVue",
          "group": "navigation@1"
        },
        {
          "command": "szh.panneauEdition",
          "when": "view == szhCockpitVue",
          "group": "navigation@2"
        },
        {
          "command": "szh.panneauExport",
          "when": "view == szhCockpitVue",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "szh.exporterArticle",
          "when": "view == szhCockpitVue && viewItem == article && (szh.archivee || szh.verrouillee)",
          "group": "inline@0"
        },
        {
          "command": "szh.metadonneesArticle",
          "when": "view == szhCockpitVue && viewItem == article && !szh.verrouillee",
          "group": "inline@1"
        },
        {
          "command": "szh.mediasArticle",
          "when": "view == szhCockpitVue && viewItem == article && !szh.verrouillee",
          "group": "inline@2"
        },
        {
          "command": "szh.supprimerArticle",
          "when": "view == szhCockpitVue && viewItem == article && !szh.verrouillee",
          "group": "inline@3"
        },
        {
          "command": "szh.convertirEnAttente",
          "when": "view == szhCockpitVue && viewItem == section-word && !szh.verrouillee",
          "group": "inline"
        },
        {
          "command": "szh.vueWord",
          "when": "view == szhCockpitVue && viewItem == section-word",
          "group": "navigation"
        },
        {
          "command": "szh.vueTraductions",
          "when": "view == szhCockpitVue && viewItem == section-traductions",
          "group": "navigation"
        },
        {
          "command": "szh.vueArticles",
          "when": "view == szhCockpitVue && viewItem == section-articles",
          "group": "navigation"
        },
        {
          "command": "szh.envoyerAuteur",
          "when": "view == szhCockpitVue && viewItem == article",
          "group": "navigation"
        },
        {
          "command": "szh.reimporterArticle",
          "when": "view == szhCockpitVue && viewItem == article && !szh.verrouillee",
          "group": "reimport@1"
        },
        {
          "command": "szh.annulerReimport",
          "when": "view == szhCockpitVue && viewItem == article && !szh.verrouillee",
          "group": "reimport@2"
        },
        {
          "command": "szh.reimporterArticle",
          "when": "view == szhCockpitVue && viewItem == word-deja && !szh.verrouillee",
          "group": "reimport@1"
        },
        {
          "command": "szh.supprimerTable",
          "when": "view == szhCockpitVue && viewItem == table && !szh.verrouillee",
          "group": "inline@1"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SZH-CSPS/szh-publishing-toolchain"
  }
}
