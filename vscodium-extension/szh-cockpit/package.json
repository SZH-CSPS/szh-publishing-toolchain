{
  "name": "szh-cockpit",
  "displayName": "SZH — Revue (cockpit)",
  "description": "Barre latérale « Revue SZH » : articles et Word en attente d'un numéro (lecture seule).",
  "version": "0.1.0",
  "publisher": "szh-csps",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "SZH",
      "properties": {
        "szh.langue": {
          "type": "string",
          "enum": ["", "fr", "de"],
          "default": "",
          "description": "%config.langue%"
        },
        "szh.apercuMode": {
          "type": "string",
          "enum": ["html", "pdf"],
          "default": "html",
          "description": "%config.apercuMode%"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "szhCockpitVue",
          "name": "Revue SZH",
          "when": "szh.estRevue"
        }
      ]
    },
    "commands": [
      {
        "command": "szh.importerWord",
        "title": "%cmd.importerWord%",
        "category": "Revue SZH",
        "icon": "$(add)"
      },
      {
        "command": "szh.cockpit.rafraichir",
        "title": "%cmd.rafraichir%",
        "category": "Revue SZH",
        "icon": "$(refresh)"
      },
      {
        "command": "szh.convertirEnAttente",
        "title": "%cmd.convertirEnAttente%",
        "category": "Revue SZH",
        "icon": "$(run-all)"
      },
      {
        "command": "szh.metadonnees",
        "title": "%cmd.metadonnees%",
        "category": "Revue SZH",
        "icon": "$(gear)"
      },
      {
        "command": "szh.supprimerArticle",
        "title": "%cmd.supprimerArticle%",
        "category": "Revue SZH",
        "icon": "$(trash)"
      },
      {
        "command": "szh.remplacerAsset",
        "title": "%cmd.remplacerAsset%",
        "category": "Revue SZH",
        "icon": "$(replace)"
      },
      {
        "command": "szh.toutExporter",
        "title": "%cmd.toutExporter%",
        "category": "Revue SZH",
        "icon": "$(export)"
      },
      {
        "command": "szh.remplacerTable",
        "title": "%cmd.remplacerTable%",
        "category": "Revue SZH",
        "icon": "$(replace)"
      },
      {
        "command": "szh.apercuMetadonnees",
        "title": "%cmd.apercuMetadonnees%",
        "category": "Revue SZH",
        "icon": "$(list-flat)"
      },
      {
        "command": "szh.reglages",
        "title": "%cmd.reglages%",
        "category": "Revue SZH",
        "icon": "$(settings-gear)"
      },
      {
        "command": "szh.basculerApercu",
        "title": "%cmd.basculerApercu%",
        "category": "Revue SZH",
        "icon": "$(preview)"
      },
      { "command": "szh.fmt.gras", "title": "%cmd.fmt.gras%", "category": "Revue SZH" },
      { "command": "szh.fmt.italique", "title": "%cmd.fmt.italique%", "category": "Revue SZH" },
      { "command": "szh.fmt.souligne", "title": "%cmd.fmt.souligne%", "category": "Revue SZH" },
      { "command": "szh.fmt.titre1", "title": "%cmd.fmt.titre1%", "category": "Revue SZH" },
      { "command": "szh.fmt.titre2", "title": "%cmd.fmt.titre2%", "category": "Revue SZH" },
      { "command": "szh.fmt.titre3", "title": "%cmd.fmt.titre3%", "category": "Revue SZH" },
      { "command": "szh.fmt.important", "title": "%cmd.fmt.important%", "category": "Revue SZH" },
      { "command": "szh.fmt.highlight", "title": "%cmd.fmt.highlight%", "category": "Revue SZH" },
      { "command": "szh.fmt.question", "title": "%cmd.fmt.question%", "category": "Revue SZH" },
      { "command": "szh.fmt.citation", "title": "%cmd.fmt.citation%", "category": "Revue SZH" },
      { "command": "szh.fmt.figure", "title": "%cmd.fmt.figure%", "category": "Revue SZH" },
      { "command": "szh.fmt.tableau", "title": "%cmd.fmt.tableau%", "category": "Revue SZH" }
    ],
    "menus": {
      "editor/context": [
        { "command": "szh.fmt.gras", "group": "1_modification@1", "when": "editorLangId == markdown && editorTextFocus" },
        { "command": "szh.fmt.italique", "group": "1_modification@2", "when": "editorLangId == markdown && editorTextFocus" },
        { "command": "szh.fmt.souligne", "group": "1_modification@3", "when": "editorLangId == markdown && editorTextFocus" },
        { "command": "szh.fmt.titre1", "group": "1_modification@4", "when": "editorLangId == markdown && editorTextFocus" },
        { "command": "szh.fmt.titre2", "group": "1_modification@5", "when": "editorLangId == markdown && editorTextFocus" },
        { "command": "szh.fmt.titre3", "group": "1_modification@6", "when": "editorLangId == markdown && editorTextFocus" },
        { "command": "szh.fmt.important", "group": "1_modification@7", "when": "editorLangId == markdown && editorTextFocus" },
        { "command": "szh.fmt.highlight", "group": "1_modification@8", "when": "editorLangId == markdown && editorTextFocus" },
        { "command": "szh.fmt.question", "group": "1_modification@9", "when": "editorLangId == markdown && editorTextFocus" },
        { "command": "szh.fmt.citation", "group": "1_modification@10", "when": "editorLangId == markdown && editorTextFocus" },
        { "command": "szh.fmt.figure", "group": "1_modification@11", "when": "editorLangId == markdown && editorTextFocus" },
        { "command": "szh.fmt.tableau", "group": "1_modification@12", "when": "editorLangId == markdown && editorTextFocus" }
      ],
      "editor/title": [
        { "command": "szh.basculerApercu", "group": "navigation", "when": "resourceExtname == .pdf && szh.estRevue" }
      ],
      "view/title": [
        {
          "command": "szh.importerWord",
          "when": "view == szhCockpitVue",
          "group": "navigation@1"
        },
        {
          "command": "szh.cockpit.rafraichir",
          "when": "view == szhCockpitVue",
          "group": "navigation@2"
        },
        {
          "command": "szh.metadonnees",
          "when": "view == szhCockpitVue",
          "group": "navigation@3"
        },
        {
          "command": "szh.toutExporter",
          "when": "view == szhCockpitVue",
          "group": "navigation@4"
        },
        {
          "command": "szh.apercuMetadonnees",
          "when": "view == szhCockpitVue",
          "group": "navigation@5"
        },
        {
          "command": "szh.reglages",
          "when": "view == szhCockpitVue",
          "group": "navigation@6"
        },
        {
          "command": "szh.basculerApercu",
          "when": "view == szhCockpitVue",
          "group": "navigation@7"
        }
      ],
      "view/item/context": [
        {
          "command": "szh.supprimerArticle",
          "when": "view == szhCockpitVue && viewItem == article",
          "group": "inline@1"
        },
        {
          "command": "szh.convertirEnAttente",
          "when": "view == szhCockpitVue && viewItem == section-word",
          "group": "inline"
        },
        {
          "command": "szh.remplacerAsset",
          "when": "view == szhCockpitVue && viewItem == asset",
          "group": "inline"
        },
        {
          "command": "szh.remplacerTable",
          "when": "view == szhCockpitVue && viewItem == table",
          "group": "inline"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SZH-CSPS/szh-publishing-toolchain"
  }
}
