      "scm/resourceState/context": [
        {
          "command": "szh.conflit.comparer",
          "when": "scmProvider == szh.conflits",
          "group": "inline@1"
        },
        {
          "command": "szh.conflit.supprimerCopie",
          "when": "scmProvider == szh.conflits",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "szh.miseEnForme",
          "group": "navigation@1",
          "when": "editorLangId == markdown && editorTextFocus"
        }
      ],
      "editor/title": [
        {
          "command": "szh.basculerApercu",
          "group": "navigation",
          "when": "resourceExtname == .pdf && (szh.estRevue || szh.estLivre) || activeCustomEditorId == 'pdf.preview' && (szh.estRevue || szh.estLivre)"
        }
      ],
      "view/title": [
        {
          "command": "szh.tutoriel",
          "when": "view == szhCockpitVue",
